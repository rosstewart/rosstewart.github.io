---
import Icon from './Icon.astro';
import { SOCIAL } from '../lib/site';
interface Props { showLabels?: boolean }
const { showLabels = true } = Astro.props;
---
<ul class="social">
  {SOCIAL.map((s) => (
    <li>
      <a href={s.url} rel={s.url.startsWith('http') ? 'me noopener' : undefined}>
        <Icon name={s.icon} />
        {showLabels ? <span>{s.label}</span> : <span class="visually-hidden">{s.label}</span>}
      </a>
    </li>
  ))}
</ul>
<style>
  .social { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.4rem 1.1rem; }
  .social a {
    display: inline-flex; align-items: center; gap: 0.4rem;
    color: var(--muted); text-decoration: none; font-size: 0.95rem; font-weight: 500;
    min-height: 2.25rem;
  }
  .social a:hover { color: var(--accent); }
</style>
