---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
interface Props { project: CollectionEntry<'research'>; headingLevel?: 'h2' | 'h3' }
const { project, headingLevel = 'h3' } = Astro.props;
const d = project.data;
const Heading = headingLevel;
const href = `/research/${project.id}/`;
---
<article class="card rcard">
  {d.cardImage && (
    <div class="media">
      <Image src={d.cardImage} alt={d.cardImageAlt ?? ''} widths={[480, 800]} sizes="(max-width: 48rem) 100vw, 33vw" />
    </div>
  )}
  <div class="body">
    <div class="top">
      {d.logo && <Image class="logo" src={d.logo} alt="" height={28} />}
      {d.status && <span class="chip">{d.status}</span>}
    </div>
    <Heading class="title"><a href={href}>{d.title}</a></Heading>
    <p class="tagline">{d.tagline}</p>
    {d.links.length > 0 && (
      <ul class="btn-links" aria-label={`${d.title} links`}>
        {d.links.slice(0, 3).map((l) => (
          <li><a class="btn-link" href={l.url}>{l.label}<Icon name="external" size={13} /></a></li>
        ))}
      </ul>
    )}
    <a class="more" href={href}>Learn more<span class="visually-hidden"> about {d.title}</span> <Icon name="arrow" size={14} /></a>
  </div>
</article>
<style>
  .rcard { display: flex; flex-direction: column; overflow: hidden; position: relative; }
  .media { background: #fff; border-bottom: 1px solid var(--border); aspect-ratio: 16 / 9; display: grid; place-items: center; padding: 0.75rem; }
  .media :global(img) { max-height: 100%; width: auto; object-fit: contain; }
  .body { padding: 1.1rem 1.25rem 1.3rem; display: flex; flex-direction: column; gap: 0.5rem; flex: 1; }
  .top { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; min-height: 1.75rem; }
  .logo { height: 28px; width: auto; }
  :global(:root[data-theme='dark']) .logo { background: #fff; border-radius: 4px; padding: 2px 4px; }
  .title { margin: 0; font-size: 1.3rem; }
  .title a { color: var(--text); text-decoration: none; }
  .title a:hover { color: var(--accent); text-decoration: underline; }
  .more { font-size: 0.92rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 0.3rem; margin-top: 0.4rem; }
  .more:hover { text-decoration: underline; }
  .tagline { color: var(--muted); margin: 0 0 0.4rem; flex: 1; }
</style>
