---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getOrdered } from '../lib/collections';
const teaching = await getOrdered('positions', (p) => p.data.section === 'teaching');
const service = await getOrdered('service');
---
<BaseLayout title="Teaching & Service" description="Teaching and professional service by Ross C. Stewart.">
  <div class="container page">
    <header class="page-intro">
      <h1>Teaching &amp; service</h1>
    </header>
    <section aria-labelledby="teaching">
      <div class="section-head"><h2 id="teaching">Teaching</h2></div>
      <ul class="entry-list">
        {teaching.map((t) => (
          <li>
            <span class="when">{t.data.dates}</span>
            <div>
              <strong>{t.data.title}</strong>
              <div class="muted">{t.data.org}</div>
              {t.data.bullets.length > 0 && <ul>{t.data.bullets.map((b) => <li>{b}</li>)}</ul>}
            </div>
          </li>
        ))}
      </ul>
    </section>
    <section class="section" aria-labelledby="service">
      <div class="section-head"><h2 id="service">Professional service</h2></div>
      <ul class="entry-list">
        {service.map((s) => (
          <li><span class="when">{s.data.year}</span><div><strong>{s.data.title}</strong></div></li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>
